# Copy to `.env` and fill in your own values. `.env` is gitignored; this file
# is not, so it must never contain a real credential.
#
# Nothing in the package reads .env directly — `alpr.env.get_credential` looks
# at Colab's secret store first, then the process environment. Load this file
# into your shell (or use direnv) if you want the values available locally.

# Kaggle API token (KaggleHub / Kaggle API 1.7+). Account > Settings > API.
KAGGLE_API_TOKEN=replace-with-your-kaggle-api-token

# Roboflow API key. Roboflow dashboard > Account > Roboflow Keys.
# Needed only when `alpr fetch-data` has to download the source datasets.
ROBOFLOW_API_KEY=replace-with-your-roboflow-api-key
